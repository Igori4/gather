{
  "name": "@gather/auth-app",
  "private": true,
  "version": "0.1.0",
  "description": "Auth microservice",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "format": "prettier --ignore-path .prettierignore --write './src/**/*.{js,ts}'",
    "test": "jest --config jest.config.ts --runInBand",
    "db:generate": "dotenv -e ../../.env.local -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate dev"
  },
  "dependencies": {
    "@gather/shared": "*",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.19.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "resend": "^3.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "dotenv-cli": "^7.4.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.2",
    "prisma": "7.8.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
