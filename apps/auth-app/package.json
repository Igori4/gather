{
  "name": "node_auth-app",
  "version": "1.0.0",
  "description": "Auth app",
  "main": "dist/index.js",
  "scripts": {
    "init": "mate-scripts init",
    "start": "node dist/index.js",
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "npm run format && mate-scripts lint",
    "format": "prettier --ignore-path .prettierignore --write './src/**/*.{js,ts}'",
    "test:only": "jest --config jest.config.ts",
    "update": "mate-scripts update",
    "postinstall": "npm run update",
    "test": "npm run lint && npm run test:only",
    "db:generate": "dotenv -e ../../.env.local -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env.local -e ../../.env -- prisma migrate dev"
  },
  "author": "Mate academy",
  "license": "GPL-3.0",
  "dependencies": {
    "@gather/shared": "*",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.19.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "resend": "^3.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/scripts": "^2.1.3",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.11.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.3.2",
    "prisma": "7.8.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "mateAcademy": {
    "projectType": "typescript"
  }
}
