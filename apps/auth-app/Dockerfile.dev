FROM node:20-alpine
RUN apk add --no-cache openssl
WORKDIR /workspace

# Copy root workspace manifest and lockfile so npm can resolve workspaces
COPY .npmrc ./
COPY package*.json ./

# Copy each workspace's manifest before npm install (workspace discovery)
COPY packages/shared/package.json ./packages/shared/
COPY apps/auth-app/package.json ./apps/auth-app/

# Install all workspace deps from the root (hoists to /workspace/node_modules)
RUN npm install

# Copy source — volumes in compose will override these at runtime for hot-reload
COPY packages/shared ./packages/shared
COPY apps/auth-app ./apps/auth-app

WORKDIR /workspace/apps/auth-app
EXPOSE 4001
