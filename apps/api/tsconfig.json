{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@gather/shared": ["../../packages/shared/src"],
      "@gather/mcp": ["../../packages/mcp/src"],
      "@modelcontextprotocol/sdk/server": ["../../node_modules/@modelcontextprotocol/sdk/dist/cjs/server/index"],
      "@modelcontextprotocol/sdk/client": ["../../node_modules/@modelcontextprotocol/sdk/dist/cjs/client/index"],
      "@modelcontextprotocol/sdk/types": ["../../node_modules/@modelcontextprotocol/sdk/dist/cjs/types"],
      "@modelcontextprotocol/sdk/inMemory": ["../../node_modules/@modelcontextprotocol/sdk/dist/cjs/inMemory"]
    }
  },
  "include": ["src", "prisma"],
  "exclude": ["node_modules", "dist", "tests"]
}
