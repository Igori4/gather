{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "paths": {
      "@gather/shared": ["../../packages/shared/src"],
      "@modelcontextprotocol/sdk/server": [
        "../../node_modules/@modelcontextprotocol/sdk/dist/cjs/server/index"
      ],
      "@modelcontextprotocol/sdk/client": [
        "../../node_modules/@modelcontextprotocol/sdk/dist/cjs/client/index"
      ],
      "@modelcontextprotocol/sdk/types": [
        "../../node_modules/@modelcontextprotocol/sdk/dist/cjs/types"
      ],
      "@modelcontextprotocol/sdk/types.js": [
        "../../node_modules/@modelcontextprotocol/sdk/dist/cjs/types"
      ],
      "@modelcontextprotocol/sdk/inMemory": [
        "../../node_modules/@modelcontextprotocol/sdk/dist/cjs/inMemory"
      ],
      "@modelcontextprotocol/sdk/inMemory.js": [
        "../../node_modules/@modelcontextprotocol/sdk/dist/cjs/inMemory"
      ]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
